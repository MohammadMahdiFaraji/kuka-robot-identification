# text files keep Unix line endings (LF) also on Windows, like the logs that MATLAB writes
*.m text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.log text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# my original scripts stay exactly as they were handed in (Windows line endings)
legacy/original_course_submission/*.m -text
legacy/original_course_submission/*.csv -text

# the CSV files are written by MATLAB (writetable, Windows line endings); keep them as they are
results/*.csv -text
results/tables/*.csv -text

*.mat binary
*.png binary
